          { q: "NH₃의 분자량은? (N=14, H=1)", a: ["17"] },
          { q: "CH₄의 분자량은? (C=12, H=1)", a: ["16"] },
          { q: "O₂의 분자량은?", a: ["32"] }
        ]
      },
      {
        name: "몰·질량",
        description: "몰수, 몰질량, 질량의 관계를 계산합니다.",
        leak: 2.4, time: 22,
        questions: [
          { q: "물 H₂O 2 mol의 질량은? (몰질량 18 g/mol)", a: ["36", "36g", "36 g"] },
          { q: "CO₂ 44 g은 몇 mol인가?", a: ["1", "1mol", "1 mol"] },
          { q: "산소 O₂ 0.5 mol의 질량은?", a: ["16", "16g", "16 g"] },
          { q: "NaCl 117 g은 몇 mol인가? (몰질량 58.5 g/mol)", a: ["2", "2mol", "2 mol"] },
          { q: "탄소 C 3 mol의 질량은?", a: ["36", "36g", "36 g"] }
        ]
      },
      {
        name: "산화수",
        description: "화합물 속 원소의 산화수를 판단합니다.",
        leak: 2.7, time: 18,
        questions: [
          { q: "H₂O에서 O의 산화수는?", a: ["-2", "−2"] },
          { q: "NaCl에서 Na의 산화수는?", a: ["+1", "1"] },
          { q: "CO₂에서 C의 산화수는?", a: ["+4", "4"] },
          { q: "O₂에서 O의 산화수는?", a: ["0"] },
          { q: "NH₃에서 N의 산화수는?", a: ["-3", "−3"] }
        ]
      },
      {
        name: "산화·환원",
        description: "산화수 변화와 전자 이동으로 산화와 환원을 구분합니다.",
        leak: 3.0, time: 18,
        questions: [
          { q: "Fe → Fe²⁺ + 2e⁻ : Fe는 산화 또는 환원?", a: ["산화"] },
          { q: "Cu²⁺ + 2e⁻ → Cu : Cu²⁺는 산화 또는 환원?", a: ["환원"] },
          { q: "산화수가 증가하면 산화 또는 환원?", a: ["산화"] },
          { q: "전자를 얻는 반응은 산화 또는 환원?", a: ["환원"] },
          { q: "환원제 자신은 산화 또는 환원되는가?", a: ["산화"] }
        ]
      }
    ];

    const state = {
      running: false, ended: false, stage: 0, correctInStage: 0,
      water: 70, score: 0, combo: 0, question: null,
      timeLeft: 15, lastTick: 0, usedIndexes: []
    };

    const $ = id => document.getElementById(id);
    const els = {
      stageNumber: $("stageNumber"), waterValue: $("waterValue"),
      comboValue: $("comboValue"), scoreValue: $("scoreValue"),
      waterVisual: $("waterVisual"), questionText: $("questionText"),
      categoryLabel: $("categoryLabel"), stageDescription: $("stageDescription"),
      timeText: $("timeText"), timeBar: $("timeBar"), timerBadge: $("timerBadge"),
      answerInput: $("answerInput"), feedback: $("feedback"),
      correctInStage: $("correctInStage"), stageProgress: $("stageProgress"),
      stageList: $("stageList"), leakRateText: $("leakRateText"),
      statusBadge: $("statusBadge"), dangerOverlay: $("dangerOverlay"),
      splash: $("splash"), visualStage: $("visualStage"),
      resultPanel: $("resultPanel"), submitButton: $("submitButton")
    };

    function normalize(value) {
      return value.trim().toLowerCase().replaceAll("−", "-").replaceAll(" ", "");
    }

    function currentStage() { return stages[state.stage]; }

    function selectQuestion() {
      const items = currentStage().questions;
      if (state.usedIndexes.length >= items.length) state.usedIndexes = [];

      let index;
      do {
        index = Math.floor(Math.random() * items.length);
      } while (state.usedIndexes.includes(index));

      state.usedIndexes.push(index);
      state.question = items[index];
      state.timeLeft = currentStage().time;
      els.questionText.textContent = state.question.q;
      els.answerInput.value = "";
      els.answerInput.focus();
    }

    function updateStageUI() {
      const stage = currentStage();
      els.stageNumber.textContent = state.stage + 1;
      els.categoryLabel.textContent = `${state.stage + 1}단계 · ${stage.name}`;
      els.stageDescription.textContent = stage.description;
      els.correctInStage.textContent = state.correctInStage;
      els.stageProgress.style.width = `${state.correctInStage / 3 * 100}%`;
      els.leakRateText.textContent = `초당 ${stage.leak.toFixed(1)}%`;

      [...els.stageList.children].forEach((pill, index) => {
        pill.classList.toggle("active", index === state.stage);
        pill.classList.toggle("done", index < state.stage);
      });
    }

    function updateStatus() {
      const stage = currentStage();
      state.water = Math.max(0, Math.min(100, state.water));

      els.waterValue.textContent = Math.round(state.water);
      els.comboValue.textContent = state.combo;
      els.scoreValue.textContent = state.score;
      els.waterVisual.style.height = `${state.water}%`;
      els.timeText.textContent = `${Math.max(0, state.timeLeft).toFixed(1)}초`;
      els.timerBadge.textContent = `${Math.ceil(Math.max(0, state.timeLeft))}초`;
      els.timeBar.style.width = `${Math.max(0, state.timeLeft / stage.time) * 100}%`;

      if (state.water < 25) {
        els.statusBadge.textContent = "장독대 붕괴 직전";
        els.dangerOverlay.style.borderWidth = "9px";
      } else if (state.water < 50) {
        els.statusBadge.textContent = "두꺼비가 힘들어한다";
        els.dangerOverlay.style.borderWidth = "4px";
      } else {
        els.statusBadge.textContent = "물이 새고 있다";
        els.dangerOverlay.style.borderWidth = "0";
      }
    }

    function showSplash(text) {
      els.splash.textContent = text;
      els.splash.style.display = "block";
      els.splash.style.animation = "none";
      void els.splash.offsetWidth;
      els.splash.style.animation = "splash .7s ease-out";
      setTimeout(() => els.splash.style.display = "none", 700);
    }

    function submitAnswer() {
      if (!state.running || state.ended) return;

      const value = normalize(els.answerInput.value);
      if (!value) {
        els.feedback.textContent = "정답을 입력하십시오.";
        return;
      }

      const correct = state.question.a.some(answer => normalize(answer) === value);

      if (correct) {
        state.combo += 1;
        state.score += 100 + state.combo * 20 + Math.round(state.timeLeft * 5);
        state.water = Math.min(100, state.water + 20);
        state.correctInStage += 1;
        els.feedback.innerHTML = `<b style="color:var(--success)">정답.</b> 물을 20% 채웠습니다. 연속 정답 ${state.combo}회.`;
        showSplash("💧 +20");

        if (state.correctInStage >= 3) {
          advanceStage();
          return;
        }
      } else {
        state.combo = 0;
        state.water -= 8;
        els.feedback.innerHTML = `<b style="color:var(--danger)">오답.</b> 정답은 ${state.question.a[0]}입니다. 물이 8% 더 빠졌습니다.`;
        els.visualStage.classList.remove("shake");
        void els.visualStage.offsetWidth;
        els.visualStage.classList.add("shake");
      }

      updateStatus();
      setTimeout(selectQuestion, 500);
    }

    function advanceStage() {
      state.score += 500;
      state.correctInStage = 0;
      state.usedIndexes = [];
      state.water = Math.min(100, state.water + 12);

      if (state.stage >= stages.length - 1) {
        finishGame(true);
        return;
      }

      state.stage += 1;
      els.feedback.innerHTML = `<b>${currentStage().name} 단계 진입.</b> 누수 속도가 더 빨라집니다.`;
      updateStageUI();
      updateStatus();
      setTimeout(selectQuestion, 650);
    }

    function finishGame(success) {
      state.running = false;
      state.ended = true;
      els.answerInput.disabled = true;
      els.submitButton.disabled = true;
      els.resultPanel.classList.remove("hidden");

      if (success) {
        state.water = 100;
        els.statusBadge.textContent = "장독대 구조 성공";
        updateStatus();
        els.resultPanel.innerHTML = `
          <h3>임무 성공</h3>
          <p>원자 번호부터 산화·환원까지 모든 단계를 통과했습니다.</p>
          <p style="margin-top:8px;color:white;font-weight:800">최종 점수: ${state.score}점</p>
          <button class="restart-btn" id="restartButton" type="button" style="margin-top:12px">다시 시작</button>
        `;
      } else {
        els.statusBadge.textContent = "두꺼비 탈진";
        els.resultPanel.innerHTML = `
          <h3>장독대의 물이 모두 빠졌습니다.</h3>
          <p>도달 단계: ${state.stage + 1}단계 ${currentStage().name}</p>
          <p style="margin-top:8px;color:white;font-weight:800">최종 점수: ${state.score}점</p>
          <button class="restart-btn" id="restartButton" type="button" style="margin-top:12px">다시 도전</button>
        `;
      }

      $("restartButton").addEventListener("click", resetGame);
    }

    function resetGame() {
      Object.assign(state, {
        running: true, ended: false, stage: 0, correctInStage: 0,
        water: 70, score: 0, combo: 0, question: null,
        timeLeft: 15, lastTick: performance.now(), usedIndexes: []
      });

      els.answerInput.disabled = false;
      els.submitButton.disabled = false;
      els.resultPanel.classList.add("hidden");
      els.feedback.textContent = "정답을 맞히면 물이 20% 채워집니다.";
      updateStageUI();
      selectQuestion();
      updateStatus();
      requestAnimationFrame(gameLoop);
    }

    function gameLoop(timestamp) {
      if (!state.running || state.ended) return;

      const delta = Math.min(.1, (timestamp - state.lastTick) / 1000);
      state.lastTick = timestamp;
      state.water -= currentStage().leak * delta;
      state.timeLeft -= delta;

      if (state.timeLeft <= 0) {
        state.combo = 0;
        state.water -= 10;
        els.feedback.innerHTML = `<b style="color:var(--danger)">시간 초과.</b> 정답은 ${state.question.a[0]}입니다.`;
        selectQuestion();
      }

      if (state.water <= 0) {
        state.water = 0;
        updateStatus();
        finishGame(false);
        return;
      }

      updateStatus();
      requestAnimationFrame(gameLoop);
    }

    els.submitButton.addEventListener("click", submitAnswer);
    els.answerInput.addEventListener("keydown", e => {
      if (e.key === "Enter") submitAnswer();
    });

    $("startButton").addEventListener("click", () => {
      $("startOverlay").classList.add("hidden");
      state.running = true;
      state.lastTick = performance.now();
      updateStageUI();
      selectQuestion();
      updateStatus();
      requestAnimationFrame(gameLoop);
    });

    updateStageUI();
    updateStatus();
  </script>
</body>
</html>

